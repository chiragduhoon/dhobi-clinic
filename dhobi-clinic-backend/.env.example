# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dhobi_clinic
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase (paste the entire service account JSON as a single line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Campus timezone for the 10:00-20:00 submission window (server clock may be UTC)
LAUNDRY_TIMEZONE=Asia/Kolkata
